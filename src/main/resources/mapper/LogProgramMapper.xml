<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="us.pax.basil.mapper.LogProgramMapper">
    <select id="addLogProgram" statementType="CALLABLE" parameterType="java.util.HashMap">
        {call add_log_program
            (
                #{programName,mode=IN},
                #{userId,mode=IN},
                #{progOid,mode=OUT,jdbcType=INTEGER}
            )
        }
    </select>

    <select id="updateLogProgram" statementType="CALLABLE" parameterType="java.util.HashMap">
        {call update_log_program
            (
                #{progOid,mode=IN},
                #{status,mode=IN}
            )
        }
    </select>  
    
    
    <select id="addLogProgramInfo" statementType="CALLABLE" parameterType="java.util.HashMap">
        {call add_log_program_Info
            (
                #{progOid,mode=IN},
                #{infoDesc,mode=IN}
            )
        }
    </select>  
</mapper>