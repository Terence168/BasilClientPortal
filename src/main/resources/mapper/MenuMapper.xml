<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="us.pax.basil.mapper.MenuMapper">

    <!-- General query mapping result -->
    <resultMap id="BaseResultMap" type="us.pax.basil.entity.Menu">
        <id column="id" property="id" />
        <result column="pid" property="pid" />
        <result column="name" property="name" />
        <result column="sort" property="sort" />
        <result column="level" property="level" />
        <result column="notes" property="notes" />
        <result column="gmt_create" property="gmtCreate" />
        <result column="creator" property="creator" />
        <result column="gmt_modified" property="gmtModified" />
        <result column="modifier" property="modifier" />
        <result column="version" property="version" />
    </resultMap>

    <select id="listAllMenus" resultType="us.pax.basil.vo.MenuTreeVO">
        select id,name ,pid from t_si_menu order by sort asc,id asc
    </select>

</mapper>
