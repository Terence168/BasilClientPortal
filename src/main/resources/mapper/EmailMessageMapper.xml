<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="us.pax.basil.mapper.EmailMessageMapper">

    <insert id="insertEmailMessage" parameterType="us.pax.basil.entity.ticket.EmailMessage"
            useGeneratedKeys="true" keyProperty="emOid" keyColumn="EM_OID">
        INSERT INTO BASIL_SEC_PRD.EMAIL_MESSAGES
        (MO_OID, U_OID, MESSAGE_SUBJECT, MESSAGE_BODY)
        VALUES
        (#{moOid}, #{uOid}, #{messageSubject}, #{messageBody})
    </insert>

</mapper>

